# Copy this file to .env and replace the placeholder with your actual key.
# .env is listed in .gitignore — never commit your real key.
#
# Get a free Groq API key (no credit card required) at:
# https://console.groq.com

GROQ_API_KEY=your_key_here

# Planned model. Retired for free/developer accounts; enterprise availability may differ.
# Set an accessible model explicitly if needed; the app never silently switches models.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Groq's recommended replacement, if you choose to migrate:
# GROQ_MODEL=openai/gpt-oss-120b

# Reuse the existing index and cached MiniLM model.
RAG_OFFLINE=true
RAG_COLLECTION=howard_research
# RAG_DB_DIR=/absolute/path/to/chroma_db
GRADIO_SERVER_PORT=7860
